{
  "name": "stock-analytics-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "test:phase13": "node --test test/phase13.test.mjs",
    "test:phase14": "node --test test/phase14.test.mjs",
    "test": "python3 -m unittest discover -s research/tests -v && npm run build && node --check server.mjs && npm run test:phase13 && npm run test:phase14",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node server.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.2"
  }
}
